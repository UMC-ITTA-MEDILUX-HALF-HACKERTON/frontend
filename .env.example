# 값은 .env.local 에 넣고 git에 올리지 않는다. 이 파일에는 이름만 둔다.
# 클라이언트에 노출되어도 되는 값만 NEXT_PUBLIC_ 접두사를 붙인다.

# 사이트 주소 (OAuth 리디렉션, 메타데이터). 운영에서는 필수
NEXT_PUBLIC_SITE_URL=

# 웹 푸시 VAPID 공개키. 백엔드가 키를 만들어 주면 그 공개키를 넣는다. 비밀키는 프론트에 두지 않는다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# 백엔드(Spring) API 주소. 끝의 슬래시는 없어도 된다. 예: http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=
